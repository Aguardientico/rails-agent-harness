# rails_agent_harness settings. Generated by `bin/rails g agent_harness:install`;
# re-running the generator keeps this file unless you pass --force.

# Branch used to compute "changed files" (the merge base with this branch).
base_branch: main

# Maximum number of output lines each check prints in bin/agent-check.
max_output_lines: 40

# Checks run by bin/agent-check. Each can be turned off or given its own command.
checks:
  # RuboCop (or Standard) on changed Ruby files.
  rubocop:
    enabled: <%= profile.rubocop? %>
    # Command to run instead of the auto-detected one (null = auto-detect).
    command: null
  # Brakeman security scan (High/Medium confidence warnings fail).
  brakeman:
    enabled: <%= profile.brakeman? %>
    command: null
  # Tests mapped to changed files.
  tests:
    enabled: <%= profile.test_framework != :none %>
    # null = auto-detect (bundle exec rspec or bin/rails test).
    command: null

# Guards that stop agents from bypassing Rails' schema workflow.
guards:
  # Block hand-written migrations; generate them with bin/rails g migration.
  migrations:
    enabled: true
  # Block hand edits to db/schema.rb and db/structure.sql.
  schema:
    enabled: true
